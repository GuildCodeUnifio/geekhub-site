{
  "name": "geekhub",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:22",
  "forwardPorts": [4200],
  "portsAttributes": {
    "4200": {
      "label": "Angular",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["angular.ng-template"]
    }
  },
  "postCreateCommand": "npm install -g @angular/cli",
  "remoteUser": "node"
}
