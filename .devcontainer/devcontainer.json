{
  "name": "geekhub",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:22",
  "forwardPorts": [4200],
  "portsAttributes": {
    "4200": {
      "label": "Angular",
      "onAutoForward": "notify"
    }
  },
  "containerEnv": {
    "NODE_OPTIONS": "--dns-result-order=ipv4first"
  },
  "mounts": [
    "source=geekhub-node_modules,target=${containerWorkspaceFolder}/geekhub/node_modules,type=volume",
    "source=geekhub-angular-cache,target=${containerWorkspaceFolder}/geekhub/.angular,type=volume"
  ],
  "customizations": {
    "vscode": {
      "extensions": ["angular.ng-template"]
    }
  },
  "postCreateCommand": "sudo chown -R node:node geekhub/node_modules geekhub/.angular && npm install -g @angular/cli && npm --prefix geekhub ci",
  "remoteUser": "node"
}
